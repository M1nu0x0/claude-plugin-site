{
  "name": "@m1nu0x0/claude-plugin-site",
  "version": "0.1.0",
  "description": "Shared Astro kit for the GitHub Pages sites of Claude Code plugins: per-language pages, SEO head, sitemap and build-time checks.",
  "license": "MIT",
  "type": "module",
  "repository": "github:M1nu0x0/claude-plugin-site",
  "keywords": ["astro-component", "astro-integration", "claude-code", "seo", "i18n"],
  "exports": {
    ".": "./src/index.mjs",
    "./site": "./src/site.mjs",
    "./hero": "./src/hero.mjs",
    "./virtual": "./src/virtual.d.ts",
    "./components/*": "./src/components/*"
  },
  "bin": {
    "plugin-site": "./bin/plugin-site.mjs"
  },
  "files": ["src", "bin", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22.23.4"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "playwright": "*"
  },
  "peerDependenciesMeta": {
    "playwright": { "optional": true }
  },
  "dependencies": {
    "html-validate": "^11.17.0",
    "node-html-parser": "^9.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "astro": "^7.4.4"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
